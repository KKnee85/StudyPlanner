# Build output
build/
**/build/

# Gradle
.gradle/
local.properties

# Kotlin and IDE files
.kotlin/
.idea/
*.iml
*.hprof

# Nix / devenv. These are machine-local: the flake pulls a shell from an
# absolute path in ~/dotfiles and the lockfile pins that path, so none of it
# belongs in the repository.
.envrc
flake.nix
flake.lock
devenv.nix
devenv.yaml
devenv.lock
result
result-*
.direnv/
.devenv/

# kotlin-language-server cache. KLS is disabled in Neovim (see
# ~/.config/nvim/lua/plugins/languages.lua); this is regenerated if it is
# ever turned back on.
kls_database.db
